<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LIGHT palette (default). Values here are the source of truth for
      daytime; values-night/colors.xml overrides each name for dark mode.

      Layouts must NOT reference these directly — they reference the
      ?attr/wai_* attributes declared in attrs.xml, which both themes
      resolve. See themes.xml.
    -->

    <!-- Surfaces: MediAI's soft off-white canvas, pure white cards -->
    <color name="background">#FFF4F6FB</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_elevated">#FFFFFFFF</color>
    <color name="surface_sunken">#FFE8EDF7</color>

    <!-- Content -->
    <color name="on_background">#FF1A1F36</color>
    <color name="on_surface">#FF1A1F36</color>
    <color name="text_secondary">#FF8A93A8</color>

    <!-- Brand -->
    <color name="primary">#FF4A7BF7</color>
    <color name="on_primary">#FFFFFFFF</color>
    <color name="secondary">#FF00897B</color>
    <color name="on_secondary">#FFFFFFFF</color>

    <!-- Semantic -->
    <color name="positive">#FF2FA97A</color>
    <color name="negative">#FFD9534F</color>
    <color name="warning">#FFC98A20</color>

    <!-- Chat -->
    <color name="bubble_user">#FFE8EDFB</color>
    <color name="on_bubble_user">#FF1A1F36</color>
    <color name="bubble_model">#FFFFFFFF</color>
    <color name="on_bubble_model">#FF1A1F36</color>
    <color name="input_fill">#FFE8EDF7</color>

    <!-- Tinted containers -->
    <color name="primary_container">#1A4A7BF7</color>
    <color name="positive_container">#1F2FA97A</color>
    <color name="negative_container">#1FD9534F</color>
    <color name="warning_container">#1FC98A20</color>

    <!-- Shape -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
</resources>