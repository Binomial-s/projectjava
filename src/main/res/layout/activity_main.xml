<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/waiBackground">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      Bottom navigation with the primary voice action promoted alongside the
      tabs, following the MediAI pattern: the mic is visually elevated rather
      than being just another nav item.

      It sits at the end rather than dead center. Centering it between two
      tabs would have meant dropping the Dashboard screen entirely, and this
      is a three-screen app — keeping all three reachable matters more than
      the exact optical position of the button.

      Being here rather than at the bottom of the chat layout also means
      listening is reachable from any tab.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/waiSurface"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_tint"
            app:itemTextColor="@color/nav_item_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_mic_button"
            style="@style/Widget.WatchAi.Button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/talk_button_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:cornerRadius="@dimen/corner_pill"
            app:icon="@drawable/ic_mic"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/waiOnPrimary" />
    </LinearLayout>

</LinearLayout>