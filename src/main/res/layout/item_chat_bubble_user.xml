<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_xs"
    android:paddingEnd="@dimen/space_sm">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.WatchAi.Card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="@dimen/space_xs"
        app:cardBackgroundColor="?attr/waiBubbleUser"
        app:cardElevation="2dp">

        <TextView
            android:id="@+id/message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.WatchAi.Bubble"
            android:textColor="?attr/waiOnBubbleUser"
            tools:text="What's the weather like?" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/timestamp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.WatchAi.Timestamp"
        tools:text="14:30" />
</LinearLayout>