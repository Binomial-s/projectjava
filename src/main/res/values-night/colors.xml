<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DARK overrides. Same names as values/colors.xml, so every layout
      resolves ?attr/wai_* correctly in either mode with no branching.

      The near-black + cyan identity is preserved here deliberately — it is
      what makes the app glanceable on a watch face in low light.
    -->

    <color name="background">#FF0B0E11</color>
    <color name="surface">#FF151A20</color>
    <color name="surface_elevated">#FF1C232B</color>
    <color name="surface_sunken">#FF0F1317</color>

    <color name="on_background">#FFE6F1F5</color>
    <color name="on_surface">#FFE6F1F5</color>
    <!-- Lightened from #888888: that gray sat at ~3.1:1 on the dark surface,
         just under the 4.5:1 floor for 14sp text. -->
    <color name="text_secondary">#FF9AA6B2</color>

    <color name="primary">#FF00E5FF</color>
    <color name="on_primary">#FF000000</color>
    <color name="secondary">#FF00FFA3</color>
    <color name="on_secondary">#FF000000</color>

    <color name="positive">#FF00E08A</color>
    <color name="negative">#FFFF6B6B</color>
    <color name="warning">#FFFFC24D</color>

    <color name="bubble_user">#FF00E5FF</color>
    <color name="on_bubble_user">#FF000000</color>
    <color name="bubble_model">#FF151A20</color>
    <color name="on_bubble_model">#FFE6F1F5</color>
    <color name="input_fill">#FF1C232B</color>

    <color name="primary_container">#3300E5FF</color>
    <color name="positive_container">#3300E08A</color>
    <color name="negative_container">#33FF6B6B</color>
    <color name="warning_container">#33FFC24D</color>
</resources>